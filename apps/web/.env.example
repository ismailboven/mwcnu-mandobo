# MWCNU Web — Environment Variables
# Salin file ini menjadi `.env.local` untuk development.

# Situs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MWCNU Mandobo

# Supabase (lihat docs/15_DEPLOYMENT.md)
# Format Baru (Supabase 2026+):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Format Legacy (tetap didukung):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Monitoring (opsional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
