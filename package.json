{
  "name": "mwcnu-mandobo",
  "version": "0.1.0",
  "private": true,
  "description": "MWCNU Mandobo Web Platform - monorepo (apps/web + packages)",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:typegen": "supabase gen types typescript --project-id mwcnu-mandobo --local > apps/web/types/database.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md,mjs,js,mts}": ["prettier --write"]
  }
}
